{
  "name": "jello-music-framework",
  "version": "0.1.0",
  "description": "Clean, MIT-licensed desktop music playback framework built with Electron and Vue 3.",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Margele1337",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.1",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "cn.margele.jello.framework",
    "productName": "Jello Music Framework",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
